# Токен от @BotFather
BOT_TOKEN=123456:ABC...
# Postgres (Neon / Supabase / Railway)
DATABASE_URL=postgres://user:pass@host:5432/db?sslmode=require
# Публичный https-адрес сервиса. Пусто = long polling (локально)
PUBLIC_URL=
# Обычно совпадает с PUBLIC_URL; локально — https-туннель на vite (порт 5173)
WEBAPP_URL=
# Любая случайная строка, проверяется в заголовке вебхука
# Ссылка на Mini App из @BotFather (/newapp): https://t.me/<bot>/<app> — для вызовов и реваншей
APP_LINK=
WEBHOOK_SECRET=
PORT=3000
# 1 = пускать без initData (только для разработки в браузере!)
DEV_AUTH_BYPASS=0
